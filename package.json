{
  "name": "teachspark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "try:generate": "tsx --env-file-if-exists=.env scripts/try-generate.ts",
    "try:paper": "tsx --env-file-if-exists=.env scripts/try-paper.ts",
    "try:render": "tsx scripts/try-render.ts",
    "export:events": "tsx --env-file-if-exists=.env scripts/export-events.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@supabase/supabase-js": "^2.112.3",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "image-size": "^2.0.2",
    "libphonenumber-js": "^1.13.11",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.19.1",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
