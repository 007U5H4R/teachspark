NODE_ENV=development
PORT=3000
# Public HTTPS base URL Twilio calls (ngrok locally, Railway in prod). No trailing slash.
PUBLIC_BASE_URL=https://your-name.ngrok-free.app
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The two sandbox join words WITHOUT the word "join", e.g. clever-tiger
TWILIO_SANDBOX_JOIN_CODE=clever-tiger
TWILIO_VALIDATE_SIGNATURE=true
ANTHROPIC_API_KEY=sk-ant-...
WORKSHEET_MODEL=claude-sonnet-5
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_PDF_BUCKET=worksheets
ADMIN_TOKEN=change-me-32-hex
# Optional; a second read-only token that shows the synthetic demo dashboard (min 8 chars, must
# differ from ADMIN_TOKEN). Leave unset to disable demo login entirely.
DEMO_TOKEN=
CRON_SECRET=change-me-32-hex
NUDGE_TIMEZONE=Asia/Kolkata
NUDGE_CRON=*/10 * * * *
SUPABASE_PAPER_BUCKET=papers
PAPER_MODEL=claude-sonnet-5
# Mixpanel (US region) project token for the landing PWA funnel. Client-side, publishable.
# Vite inlines VITE_* at BUILD time, so Railway must have this set in its BUILD env, not just runtime.
# Leave blank to disable analytics entirely (the SDK no-ops).
VITE_MIXPANEL_TOKEN=
# Microsoft Clarity project id for click/scroll heatmaps + input-masked session replay on the landing
# PWA. Publishable, client-side; Vite inlines VITE_* at BUILD time, so Railway must have it in its
# BUILD env. Leave blank to disable Clarity entirely (the SDK no-ops).
VITE_CLARITY_ID=
# Optional "Continue with Google" fast-path on the signup form. A public OAuth Client ID from Google
# Cloud Console (Credentials → OAuth 2.0 Client ID → Web application). Add http://localhost:5173 and
# the production origin to "Authorized JavaScript origins". Client-side, publishable; Vite inlines it
# at BUILD time. Leave blank to hide the button entirely (the form works unchanged).
VITE_GOOGLE_CLIENT_ID=
